# Copy to .env.local and fill in. Never commit .env.local.

# --- OpenAI (server-only) ---
OPENAI_API_KEY=
OPENAI_MODEL=                 # a current function-calling model available to your key

# --- Supabase (server-only) ---
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # service_role / secret key; never NEXT_PUBLIC_

# --- PayPal (sandbox only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=             # server-only
PAYPAL_CLIENT_SECRET=         # server-only
NEXT_PUBLIC_PAYPAL_CLIENT_ID= # same client ID, exposed to the browser SDK

# --- App ---
SESSION_SECRET=               # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_APP_URL=http://localhost:3000
